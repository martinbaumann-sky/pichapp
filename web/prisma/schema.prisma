// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  // Uses DATABASE_URL from your environment (.env)
  url      = env("DATABASE_URL")
}

/// Enums
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Position {
  ARQUERO
  DEFENSA
  LATERAL
  VOLANTE
  DELANTERO
}

enum UserRole {
  PLAYER
  VENUE_ADMIN
  SUPERADMIN
}

enum MatchStatus {
  PUBLISHED
  FULL
  CANCELED
  FINISHED
  CONFIRMED
  CANCELED_MINIMUM
}

enum SpotStatus {
  AVAILABLE
  RESERVED
  PAID
  CANCELED
  NO_SHOW
  REFUNDED
}

enum WaitlistStatus {
  WAITING
  INVITED
  EXPIRED
  JOINED
}

enum PaymentProvider {
  MP
  TB
  WEBPAY
  KHIPU
  FINTOC
  FLOW
  MP_QR
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum VenueSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

// Friend system
enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

/// Models
model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  passwordHash    String?
  isAdmin         Boolean   @default(false)
  role            UserRole  @default(PLAYER)
  createdAt       DateTime  @default(now())
  emailVerifiedAt DateTime?
  disabledAt      DateTime?

  profile            Profile?
  matches            Match[]             @relation("MatchOrganizer")
  spots              Spot[]
  payments           Payment[]
  waitlist           WaitlistEntry[]
  sessions           Session[]
  emailVerifications EmailVerification[]

  localPassword LocalPassword?

  oauthAccounts OAuthAccount[]

  venues Venue[] @relation("VenueOwner")

  guestInvitesSent     GuestInvite[] @relation("GuestInviteInviter")
  guestInvitesReceived GuestInvite[] @relation("GuestInviteGuest")

  // Friend relations
  friendsRequested Friend[] @relation("FriendRequester")
  friendsReceived  Friend[] @relation("FriendAddressee")
}

model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  phone     String
  comuna    String
  position  Position?
  // Legacy single rating kept for compatibility; new detailed ratings below
  rating    Float     @default(5.0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Venue {
  id               String    @id @default(uuid())
  ownerId          String
  name             String
  taxId            String
  address          String
  comuna           String
  lat              Float?
  lng              Float?
  phone            String?
  payoutEmail      String
  accountHolder    String
  plan             String    @default("gratis")
  verified         Boolean   @default(false)
  mpAccountId      String?
  placeId          String?
  mpAccessToken    String?
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  mpUserId         String?
  createdAt        DateTime  @default(now())

  owner         User                @relation("VenueOwner", fields: [ownerId], references: [id])
  fields        Field[]
  matches       Match[]
  subscriptions VenueSubscription[]
}

model Field {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  createdAt DateTime @default(now())

  venue   Venue   @relation(fields: [venueId], references: [id])
  matches Match[]
}

model Match {
  id                String      @id @default(uuid())
  title             String
  organizerId       String
  venueId           String?
  fieldId           String?
  comuna            String
  startsAt          DateTime
  durationMins      Int
  pricePerSpot      Int
  totalSpots        Int
  minSpotsToConfirm Int         @default(0)
  level             SkillLevel
  status            MatchStatus @default(PUBLISHED)
  public            Boolean     @default(true)
  createdAt         DateTime    @default(now())

  venueName     String?
  venueAddress  String?
  lat           Float?
  lng           Float?
  coverImageUrl String?

  organizer    User            @relation("MatchOrganizer", fields: [organizerId], references: [id])
  venue        Venue?          @relation(fields: [venueId], references: [id])
  field        Field?          @relation(fields: [fieldId], references: [id])
  spots        Spot[]
  waitlist     WaitlistEntry[]
  payments     Payment[]
  guestInvites GuestInvite[]

  @@index([startsAt])
  @@index([comuna])
  @@index([pricePerSpot])
  @@index([venueId])
}

model Spot {
  id        String     @id @default(uuid())
  matchId   String
  userId    String?
  status    SpotStatus @default(AVAILABLE)
  // Nuevo: equipo asignado por organizador o jugador (ej: "A", "B")
  team      String?
  // Nuevo: posición preferida/registrada para este spot
  position  Position?
  holdUntil DateTime?
  priceCLP  Int
  createdAt DateTime   @default(now())

  match       Match        @relation(fields: [matchId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  payment     Payment?     @relation("SpotPayment")
  guestInvite GuestInvite?

  @@unique([matchId, userId])
  @@index([matchId, status])
}

model GuestInvite {
  id          String    @id @default(uuid())
  matchId     String
  inviterId   String
  guestUserId String
  spotId      String    @unique
  name        String
  email       String
  position    Position?
  createdAt   DateTime  @default(now())

  match   Match @relation(fields: [matchId], references: [id])
  inviter User  @relation("GuestInviteInviter", fields: [inviterId], references: [id])
  guest   User  @relation("GuestInviteGuest", fields: [guestUserId], references: [id])
  spot    Spot  @relation(fields: [spotId], references: [id])

  @@index([matchId])
  @@index([inviterId])
  @@index([guestUserId])
}

model OrganizerRating {
  id          String   @id @default(cuid())
  matchId     String
  raterId     String // jugador
  organizerId String
  comms       Int // 0..10
  punctual    Int
  fairness    Int
  overall     Decimal
  createdAt   DateTime @default(now())

  @@unique([matchId, raterId])
  @@index([organizerId, createdAt])
}

model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  raterId   String // organizador
  playerId  String
  skill     Int
  behavior  Int
  teamwork  Int
  overall   Decimal
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
  @@index([playerId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
  @@index([expiresAt])
}

// Missing model: Payment

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}

model WaitlistEntry {
  id          String         @id @default(uuid())
  matchId     String
  userId      String
  position    Int
  status      WaitlistStatus @default(WAITING)
  invitedAt   DateTime?
  expiresAt   DateTime?
  inviteToken String?        @unique
  createdAt   DateTime       @default(now())

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([matchId, status, position])
}

model Payment {
  id          String          @id @default(uuid())
  provider    PaymentProvider @default(MP)
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  amountCLP   Int
  userId      String
  matchId     String
  // Equipo seleccionado por el pagador al reservar/inscribirse ("CLARO" | "OSCuro")
  team        String?
  // Posición (opcional) enviada junto al pago
  position    Position?
  spotId      String?         @unique
  createdAt   DateTime        @default(now())
  raw         Json?

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])
  spot  Spot? @relation("SpotPayment", fields: [spotId], references: [id])

  @@index([providerRef])
}

model VenueSubscription {
  id                 String                  @id @default(uuid())
  venueId            String
  plan               String
  status             VenueSubscriptionStatus @default(PENDING)
  mpPreapprovalId    String?
  mpPlanId           String?
  externalReference  String                  @unique
  initPoint          String?
  backUrl            String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  activatedAt        DateTime?
  canceledAt         DateTime?
  nextChargeAt       DateTime?
  lastChargeAt       DateTime?
  cancellationReason String?

  venue Venue @relation(fields: [venueId], references: [id])

  @@index([venueId, status])
}

// Local auth password storage to persist credentials across runs/migrations
model LocalPassword {
  userId String @id
  hash   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("LocalPassword")
}

// Directed friend relationship (requester -> addressee)
// We treat ACCEPTED as mutual friendship.
model Friend {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}
