generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Models
model User {
  id                   String              @id @default(uuid())
  email                String?             @unique
  passwordHash         String?
  isAdmin              Boolean             @default(false)
  createdAt            DateTime            @default(now())
  emailVerifiedAt      DateTime?
  role                 UserRole            @default(PLAYER)
  disabledAt           DateTime?
  emailVerifications   EmailVerification[]
  friendsReceived      Friend[]            @relation("FriendAddressee")
  friendsRequested     Friend[]            @relation("FriendRequester")
  guestInvitesReceived GuestInvite[]       @relation("GuestInviteGuest")
  guestInvitesSent     GuestInvite[]       @relation("GuestInviteInviter")
  localPassword        LocalPassword?
  matches              Match[]             @relation("MatchOrganizer")
  oauthAccounts        OAuthAccount[]
  payments             Payment[]
  profile              Profile?
  sessions             Session[]
  spots                Spot[]
  venues               Venue[]             @relation("VenueOwner")
  waitlist             WaitlistEntry[]
}

model Profile {
  id         String      @id @default(uuid())
  userId     String      @unique
  name       String
  phone      String
  comuna     String
  position   Position?
  rating     Float       @default(5.0)
  createdAt  DateTime    @default(now())
  skillLevel SkillLevel?
  bio        String?
  avatarUrl  String?
  user       User        @relation(fields: [userId], references: [id])
}

model Venue {
  id                String              @id @default(uuid())
  name              String
  address           String
  comuna            String
  lat               Float?
  lng               Float?
  createdAt         DateTime            @default(now())
  ownerId           String
  taxId             String
  phone             String?
  payoutEmail       String
  accountHolder     String
  plan              String              @default("gratis")
  verified          Boolean             @default(false)
  mpAccountId       String?
  placeId           String?
  mpAccessToken     String?
  mpRefreshToken    String?
  mpTokenExpiresAt  DateTime?
  mpUserId          String?
  mpAccountType     String?
  mpCollectorId     String?
  paymentProvider   PaymentProvider     @default(MP)
  flowApiKey        String?
  flowApiKeyHash    String?
  flowSecretKey     String?
  flowEnv           String?             @default("SANDBOX")
  payoutMethod      VenuePayoutMethod   @default(MP_WALLET)
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountRut    String?
  fields            Field[]
  matches           Match[]
  owner             User                @relation("VenueOwner", fields: [ownerId], references: [id])
  payouts           VenuePayout[]
  subscriptions     VenueSubscription[]

  @@index([flowApiKeyHash])
}

model Field {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  createdAt DateTime @default(now())
  venue     Venue    @relation(fields: [venueId], references: [id])
  matches   Match[]
}

model Match {
  id                String          @id @default(uuid())
  title             String
  organizerId       String
  fieldId           String?
  comuna            String
  startsAt          DateTime
  durationMins      Int
  pricePerSpot      Int
  totalSpots        Int
  level             SkillLevel
  status            MatchStatus     @default(PUBLISHED)
  public            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  venueName         String?
  venueAddress      String?
  lat               Float?
  lng               Float?
  coverImageUrl     String?
  minSpotsToConfirm Int             @default(0)
  venueId           String?
  guestInvites      GuestInvite[]
  field             Field?          @relation(fields: [fieldId], references: [id])
  organizer         User            @relation("MatchOrganizer", fields: [organizerId], references: [id])
  venue             Venue?          @relation(fields: [venueId], references: [id])
  payments          Payment[]
  spots             Spot[]
  venuePayouts      VenuePayout[]
  waitlist          WaitlistEntry[]

  @@index([startsAt])
  @@index([comuna])
  @@index([pricePerSpot])
  @@index([venueId])
}

model Spot {
  id          String       @id @default(uuid())
  matchId     String
  userId      String?
  status      SpotStatus   @default(AVAILABLE)
  team        String?
  position    Position?
  holdUntil   DateTime?
  priceCLP    Int
  createdAt   DateTime     @default(now())
  guestInvite GuestInvite?
  payment     Payment?     @relation("SpotPayment")
  match       Match        @relation(fields: [matchId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([matchId, status])
}

model GuestInvite {
  id          String    @id @default(uuid())
  matchId     String
  inviterId   String
  guestUserId String
  spotId      String    @unique
  name        String
  email       String
  position    Position?
  createdAt   DateTime  @default(now())
  guest       User      @relation("GuestInviteGuest", fields: [guestUserId], references: [id])
  inviter     User      @relation("GuestInviteInviter", fields: [inviterId], references: [id])
  match       Match     @relation(fields: [matchId], references: [id])
  spot        Spot      @relation(fields: [spotId], references: [id])

  @@index([matchId])
  @@index([inviterId])
  @@index([guestUserId])
}

model OrganizerRating {
  id          String   @id @default(cuid())
  matchId     String
  raterId     String
  organizerId String
  comms       Int
  punctual    Int
  fairness    Int
  overall     Decimal
  createdAt   DateTime @default(now())

  @@unique([matchId, raterId])
  @@index([organizerId, createdAt])
}

model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  raterId   String
  playerId  String
  skill     Int
  behavior  Int
  teamwork  Int
  overall   Decimal
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
  @@index([playerId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
  @@index([expiresAt])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}

model WaitlistEntry {
  id          String         @id @default(uuid())
  matchId     String
  userId      String
  position    Int
  status      WaitlistStatus @default(WAITING)
  invitedAt   DateTime?
  expiresAt   DateTime?
  inviteToken String?        @unique
  createdAt   DateTime       @default(now())
  match       Match          @relation(fields: [matchId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@index([matchId, status, position])
}

model Payment {
  id          String          @id @default(uuid())
  provider    PaymentProvider @default(MP)
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  amountCLP   Int
  userId      String
  matchId     String
  team        String?
  position    Position?
  spotId      String?         @unique
  createdAt   DateTime        @default(now())
  raw         Json?
  match       Match           @relation(fields: [matchId], references: [id])
  spot        Spot?           @relation("SpotPayment", fields: [spotId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  payout      VenuePayout?

  @@index([providerRef])
}

model VenuePayout {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId        String
  matchId        String
  paymentId      String            @unique
  status         VenuePayoutStatus @default(PENDING)
  method         VenuePayoutMethod
  amountCLP      Int
  platformFeeCLP Int
  providerFeeCLP Int
  netAmountCLP   Int
  destination    String?
  notes          String?
  createdAt      DateTime          @default(now())
  processedAt    DateTime?
  match          Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  venue          Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, status])
  @@index([matchId])
}

model VenueSubscription {
  id                 String                  @id @default(uuid())
  venueId            String
  plan               String
  status             VenueSubscriptionStatus @default(PENDING)
  mpPreapprovalId    String?
  mpPlanId           String?
  externalReference  String                  @unique
  initPoint          String?
  backUrl            String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  activatedAt        DateTime?
  canceledAt         DateTime?
  nextChargeAt       DateTime?
  lastChargeAt       DateTime?
  cancellationReason String?
  venue              Venue                   @relation(fields: [venueId], references: [id])

  @@index([venueId, status])
}

model LocalPassword {
  userId String @id
  hash   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("LocalPassword")
}

model Friend {
  id          String       @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id])
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

/// Enums
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Position {
  ARQUERO
  DEFENSA
  LATERAL
  VOLANTE
  DELANTERO
}

enum UserRole {
  PLAYER
  VENUE_ADMIN
  SUPERADMIN
}

enum MatchStatus {
  PUBLISHED
  FULL
  CANCELED
  FINISHED
  CONFIRMED
  CANCELED_MINIMUM
}

enum SpotStatus {
  AVAILABLE
  RESERVED
  PAID
  CANCELED
  NO_SHOW
  REFUNDED
}

enum WaitlistStatus {
  WAITING
  INVITED
  EXPIRED
  JOINED
}

enum PaymentProvider {
  MP
  TB
  WEBPAY
  KHIPU
  FINTOC
  FLOW
  MP_QR
}

enum VenuePayoutMethod {
  MP_WALLET
  FLOW
  BANK_TRANSFER
}

enum VenuePayoutStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum VenueSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELED
  EXPIRED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}
